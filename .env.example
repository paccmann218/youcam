YOUCAM_API_KEY=
# Console secret. The server authenticates with YOUCAM_API_KEY. Kept here so it is not lost.
YOUCAM_SECRET_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
# sd while developing. Switch a single scan to HD in the UI when you mean to spend the units.
YOUCAM_MODE=sd

# Phrasing only. The verdict math does not call this.
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5-5

# Optional second copy of the ledger. The app runs without it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
