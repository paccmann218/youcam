<?xml version="1.0" encoding="utf-8"?>
<!-- WorthIt launcher icon: the W mark (a data line that breaks out of the wobble band, ending on a data point),
     drawn in the watch's neobrutalist style: yellow disc, thick ink outline, clay point. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:fillColor="#111111" android:pathData="M58,58m-46,0a46,46 0,1 1,92 0a46,46 0,1 1,-92 0" />
    <path android:fillColor="#FFD23F" android:strokeColor="#111111" android:strokeWidth="6"
        android:pathData="M54,54m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0" />
    <!-- the wobble band -->
    <path android:fillColor="#00000000" android:strokeColor="#111111" android:strokeWidth="2.5"
        android:strokeAlpha="0.3" android:pathData="M25,49.2 L83,49.2 M25,67.6 L83,67.6" />
    <!-- the W -->
    <path android:fillColor="#00000000" android:strokeColor="#111111" android:strokeWidth="9"
