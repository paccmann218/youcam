        android:pathData="M31.6,44.4 L42.2,72.4 L54,55.6 L65.8,72.4 L76.4,37.2" />
    <!-- the data point -->
    <path android:fillColor="#FF7A45" android:strokeColor="#111111" android:strokeWidth="4"
        android:pathData="M76.4,37.2m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
